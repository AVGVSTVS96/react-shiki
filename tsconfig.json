{
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "module": "nodenext",
    "target": "esnext",
    "types": ["node"],
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": ["*.ts", "tools", ".github/scripts"]
}
