{
  "name": "root",
  "private": true,
  "license": "MIT",
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*"
    ],
    "catalog": {
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0"
    }
  },
  "type": "module",
  "scripts": {
    "prepare": "lefthook install",
    "dev": "bun --filter '*' dev",
    "build": "bun --filter '*' build",
    "check": "bun run package:build && oxlint && oxfmt --check && tsc -p . && bun --filter '*' typecheck && bun --filter react-shiki test",
    "fix": "oxlint --fix; oxfmt",
    "package:dev": "bun --filter react-shiki dev",
    "package:build": "bun --filter react-shiki build",
    "playground:dev": "bun --filter playground dev",
    "playground:build": "bun --filter playground build",
    "bench": "bun --filter react-shiki bench",
    "changeset": "changeset",
    "ci:publish": "bun run package:build && changeset pack --out-dir .release && node .github/scripts/repack.ts && changeset publish --from-pack-dir .release",
    "ci:version": "changeset version && bun install --lockfile-only"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@oxlint/plugins": "1.92.0",
    "@types/node": "25.9.9",
    "changesets-changelog-clean": "^1.4.0",
    "lefthook": "2.2.2",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "typescript": "^7.0.2",
    "ultracite": "8.1.1"
  },
  "packageManager": "bun@1.4.3"
}
