{
  "name": "react-shiki",
  "version": "0.11.2",
  "description": "Syntax highlighter component for react using shiki",
  "keywords": [
    "code",
    "highlighter",
    "react",
    "react-syntax-highlighter",
    "shiki",
    "syntax",
    "syntax-highlighter"
  ],
  "homepage": "https://react-shiki.vercel.app/",
  "license": "MIT",
  "author": {
    "name": "Bassim Shahidy",
    "email": "bassim@shahidy.com",
    "url": "https://bassim.build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AVGVSTVS96/react-shiki.git",
    "directory": "packages/react-shiki"
  },
  "files": [
    "dist",
    "src/styles/css.d.ts"
  ],
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./web": {
      "types": "./dist/web.d.mts",
      "default": "./dist/web.mjs"
    },
    "./core": {
      "types": "./dist/core.d.mts",
      "default": "./dist/core.mjs"
    },
    "./css": {
      "types": "./src/styles/css.d.ts",
      "default": "./dist/style.css"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsdown",
    "check:package": "node scripts/check-package.ts",
    "test": "vitest run",
    "bench": "vitest bench --typecheck.enabled=false",
    "typecheck": "tsc"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "dequal": "^2.0.3",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "shiki": "^4.5.0",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@tsdown/css": "^0.23.7",
    "@types/hast": "^3.0.5",
    "@types/node": "25.9.9",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.2.1",
    "html-react-parser": "^6.1.9",
    "jsdom": "^31.0.0",
    "publint": "^0.3.25",
    "react": "catalog:",
    "react-dom": "catalog:",
    "rolldown": "^1.3.0",
    "tsdown": "^0.23.7",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "@types/react": ">=16.14.0",
    "@types/react-dom": ">=16.14.0",
    "react": ">=16.14.0",
    "react-dom": ">=16.14.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "@types/react-dom": {
      "optional": true
    }
  }
}
